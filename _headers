# Ensure correct MIME types for static assets
# This prevents SPA fallback from serving HTML for static files

/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://ajax.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' blob: https://3d.timrx.live https://blog.timrx.live https://*.timrx.live https://assets.meshy.ai https://*.meshy.ai https://*.amazonaws.com https://ajax.googleapis.com https://www.gstatic.com; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/*.css
  Content-Type: text/css; charset=utf-8

/*.js
  Content-Type: application/javascript; charset=utf-8

/admin/*.css
  Content-Type: text/css; charset=utf-8

/admin/*.js
  Content-Type: application/javascript; charset=utf-8

/3dprint-modules/*.css
  Content-Type: text/css; charset=utf-8

/3dprint-modules/*.js
  Content-Type: application/javascript; charset=utf-8

/3dprint-modules/css/*.css
  Content-Type: text/css; charset=utf-8

# Font files
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Content-Type: font/woff
  Cache-Control: public, max-age=31536000, immutable

# Images — long cache for all image assets
/img/*
  Cache-Control: public, max-age=31536000, immutable

/vid/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Content-Type: image/png

/*.svg
  Content-Type: image/svg+xml

/*.jpg
  Content-Type: image/jpeg

/*.jpeg
  Content-Type: image/jpeg

/*.webp
  Content-Type: image/webp

/*.mp4
  Content-Type: video/mp4

/*.webm
  Content-Type: video/webm

/*.mov
  Content-Type: video/quicktime

/*.glb
  Content-Type: model/gltf-binary

/*.gltf
  Content-Type: model/gltf+json; charset=utf-8

/*.bin
  Content-Type: application/octet-stream

/*.usdz
  Content-Type: model/vnd.usdz+zip

/*.ico
  Content-Type: image/x-icon

# Versioned CSS/JS — long cache (cache-busted via ?v= param)
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/media/index.css
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable
