# Ensure correct MIME types for static assets
# This prevents SPA fallback from serving HTML for static files

/*
  # X-Frame-Options removed deliberately: it cannot whitelist a single
  # cross-origin (Tag Assistant lives at https://tagassistant.google.com) so
  # we rely on CSP frame-ancestors below, which IS per-origin granular and
  # the modern equivalent. All current browsers prefer frame-ancestors.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://ajax.googleapis.com https://www.gstatic.com https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.googleadservices.com https://www.google-analytics.com https://analytics.google.com https://www.google.com https://challenges.cloudflare.com https://googleads.g.doubleclick.net https://*.g.doubleclick.net; script-src-elem 'self' 'unsafe-inline' https://challenges.cloudflare.com https://cdn.jsdelivr.net https://ajax.googleapis.com https://www.gstatic.com https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.googleadservices.com https://www.google-analytics.com https://analytics.google.com https://www.google.com https://googleads.g.doubleclick.net https://*.g.doubleclick.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://www.googletagmanager.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' blob: https://3d.timrx.live https://blog.timrx.live https://*.timrx.live https://assets.meshy.ai https://*.meshy.ai https://*.amazonaws.com https://ajax.googleapis.com https://www.gstatic.com https://www.googletagmanager.com https://www.google.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googleadservices.com https://*.g.doubleclick.net https://stats.g.doubleclick.net https://challenges.cloudflare.com; child-src https://challenges.cloudflare.com https://td.doubleclick.net https://www.googletagmanager.com https://www.youtube.com https://www.youtube-nocookie.com; frame-src https://td.doubleclick.net https://www.googletagmanager.com https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com; frame-ancestors 'self' https://tagassistant.google.com; object-src 'none'; base-uri 'self'; form-action 'self'
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/*.css
  Content-Type: text/css; charset=utf-8

/*.js
  Content-Type: application/javascript; charset=utf-8

/admin/*.css
  Content-Type: text/css; charset=utf-8

/admin/*.js
  Content-Type: application/javascript; charset=utf-8

/3dprint-modules/*.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/3dprint-modules/*.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/3dprint-modules/css/*.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/3dprint-modules/media/*.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/3dprint-modules/3dmodels/*
  Cache-Control: public, max-age=31536000, immutable

/captions/*
  Cache-Control: public, max-age=31536000, immutable

# Font files
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Content-Type: font/woff
  Cache-Control: public, max-age=31536000, immutable

# Images — long cache for all image assets
/img/*
  Cache-Control: public, max-age=31536000, immutable

/vid/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Content-Type: image/png

/*.svg
  Content-Type: image/svg+xml

/*.jpg
  Content-Type: image/jpeg

/*.jpeg
  Content-Type: image/jpeg

/*.mp4
  Content-Type: video/mp4

/*.webm
  Content-Type: video/webm

/*.mov
  Content-Type: video/quicktime

/*.glb
  Content-Type: model/gltf-binary
  Cache-Control: public, max-age=31536000, immutable

/*.gltf
  Content-Type: model/gltf+json; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/*.bin
  Content-Type: application/octet-stream

/*.usdz
  Content-Type: model/vnd.usdz+zip

/*.ico
  Content-Type: image/x-icon

# Versioned CSS/JS — long cache (cache-busted via ?v= param)
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/media/index.css
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable

/js/config.js
  Cache-Control: public, max-age=31536000, immutable

/js/analytics.js
  Cache-Control: public, max-age=31536000, immutable

/js/gsap.min.js
  Cache-Control: public, max-age=31536000, immutable

/js/ScrollTrigger.min.js
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/trustpilot.css
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted tech-stack icons (replacing jsdelivr + GitHub raw favicon)
/img/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Hub page CSS — versioned via ?v= param
/hub.css
  Cache-Control: public, max-age=31536000, immutable

/media/hub.css
  Cache-Control: public, max-age=31536000, immutable

/footer.css
  Cache-Control: public, max-age=31536000, immutable

/site-shell.css
  Cache-Control: public, max-age=31536000, immutable

/fonts/fonts.css
  Cache-Control: public, max-age=31536000, immutable

# Hub page JS — versioned via ?v= param
/hub.js
  Cache-Control: public, max-age=31536000, immutable
