# --- Rewrites: serve HTML at clean URL (200 = serve file content) ---
# These MUST come first so /archive matches before falling through.
# Do NOT add / -> /index.html (V3 rejects it; Pages auto-serves index.html at /).
/archive         /archive.html           200
/about           /about.html             200
/hub             /hub.html               200
/3dprint         /3dprint.html           200
/blogs           /blogs.html             200
/write           /write.html             200
/terms           /terms.html             200
/cookies         /cookies.html           200
/privacy         /privacy.html           200
/admin           /admin/admin.html       200
/admin/edit      /admin/admin-edit.html  200

# --- Canonical: redirect .html -> clean URL (301 for SEO) ---
/archive.html    /archive        301
/about.html      /about          301
/hub.html        /hub            301
/3dprint.html    /3dprint        301
/blogs.html      /blogs          301
/write.html      /write          301
/terms.html      /terms          301
/cookies.html    /cookies        301
/privacy.html    /privacy        301
/admin.html      /admin          301
/admin-edit.html /admin/edit     301
/index.html      /               301
